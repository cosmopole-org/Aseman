# Copy to the bootstrap configuration directory only when preparing by hand.
# `asemanctl bootstrap --profile compact` generates these values without committing
# secrets. Nomad itself is operator-supplied under ADR 0002.
ASEMAN_CONFIG_DIR=/etc/aseman/compact
ASEMAN_NODE_ID=replace-with-node-id
ASEMAN_NODE_IMAGE=registry.example/aseman-node@sha256:replace
ASEMAN_VMM_IMAGE=registry.example/aseman-vmm@sha256:replace
ASEMAN_METER_IMAGE=registry.example/aseman-meter@sha256:replace
ASEMAN_NOMAD_BACKEND_IMAGE=registry.example/aseman-vmm-backend-nomad@sha256:replace
POSTGRES_IMAGE=postgres:18-bookworm
VMM_NODE_CERT_SHA256=replace-with-64-lowercase-hex
VMM_METER_CERT_SHA256=replace-with-64-lowercase-hex
NOMAD_ENDPOINT=http://host.docker.internal:4646
