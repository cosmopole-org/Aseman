{
  "version": "1",
  "artifact": "A903",
  "source": "apps/asemanctl/src/cli dispatch plus this compatibility contract",
  "exit_codes": {
    "0": "command completed or help was displayed",
    "1": "usage error or command execution failed",
    "2": "typed process configuration was invalid before command dispatch"
  },
  "output_modes": {
    "human": "stable for operator meaning, not for field parsing",
    "json_optional": "a documented --json flag emits one JSON document",
    "json": "always emits one JSON document"
  },
  "json_error": {
    "schema": "aseman.cli.error.v1",
    "required": ["schema", "ok", "command", "error"],
    "note": "reserved target envelope; commands not marked json/json_optional must not be parsed as structured output"
  },
  "json_result": {
    "schema": "aseman.cli.result.v1",
    "required": ["schema", "ok", "command", "exit_code", "data", "warnings"]
  },
  "commands": [
    {"name": "install", "class": "legacy_mutation", "output": "json_optional"},
    {"name": "uninstall", "class": "legacy_mutation", "output": "json_optional"},
    {"name": "purge", "class": "legacy_mutation", "output": "json_optional"},
    {"name": "start", "class": "legacy_mutation", "output": "json_optional"},
    {"name": "pause", "class": "legacy_mutation", "output": "json_optional"},
    {"name": "resume", "class": "legacy_mutation", "output": "json_optional"},
    {"name": "stop", "class": "legacy_mutation", "output": "json_optional"},
    {"name": "stats", "class": "read", "output": "json_optional"},
    {"name": "run", "class": "legacy_mutation", "output": "json_optional"},
    {"name": "status", "class": "read", "output": "json_optional"},
    {"name": "pprof", "class": "read", "output": "json_optional"},
    {"name": "vms", "class": "legacy_mixed", "output": "json_optional"},
    {"name": "cluster", "class": "legacy_mixed", "output": "json_optional"},
    {"name": "bootstrap", "class": "journaled_mutation", "output": "json_optional"},
    {"name": "module", "class": "mixed", "output": "json_optional"},
    {"name": "modules", "class": "alias", "alias_for": "module", "output": "json_optional"},
    {"name": "doctor", "class": "read", "output": "json_optional"},
    {"name": "backup", "class": "journaled_mutation", "output": "json_optional"},
    {"name": "restore", "class": "journaled_mutation", "output": "json_optional"},
    {"name": "upgrade", "class": "journaled_mutation", "output": "json_optional"},
    {"name": "support-bundle", "class": "journaled_mutation", "output": "json_optional"}
  ],
  "compatibility": {
    "casparctl": "one-way warning alias to the same implementation under ADR 0004",
    "change_rule": "removing or renaming a command, changing an exit meaning, or changing a structured schema requires a versioned contract and compatibility evidence"
  }
}
