{
  "cniVersion": "1.0.0",
  "name": "aseman-restricted",
  "plugins": [
    {
      "type": "bridge",
      "bridge": "aseman-cni0",
      "isGateway": true,
      "ipMasq": false,
      "hairpinMode": false,
      "ipam": {
        "type": "host-local",
        "ranges": [[{ "subnet": "172.30.0.0/16" }]],
        "routes": [{ "dst": "0.0.0.0/0" }]
      }
    },
    { "type": "firewall", "backend": "iptables" },
    { "type": "portmap", "capabilities": { "portMappings": true } }
  ]
}
