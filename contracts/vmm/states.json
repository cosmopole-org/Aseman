    "rules": [
      "The node owns desired state. Every accepted desired change, state or spec, advances the generation by exactly one (compare-and-set on the generation the caller read).",
      "`paused` is reachable only from `running`; any state may go to `stopped` or `deleted`; `deleted` never changes."
    ]
  },
  "observed": {
    "states": [
      "unknown",
      "pending",
      "running",
      "paused",
      "stopped",
      "failed",
      "lost"
    ],
    "rules": [
      "The VMM owns observed state. An observation carries the desired generation it acted on and a provider sequence.",
      "An observation is accepted only when (generation, sequence) is greater than the recorded one and its generation is not newer than desired (`stale_observation` otherwise).",
      "`lost` means the provider no longer reports an instance it had; `unknown` means it has not reported yet."
    ]
  },
