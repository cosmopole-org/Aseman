{
  "version": "1",
  "artifact": "A505",
  "description": "Where every native runtime operation (A006) and every node-facing IVmm method goes when the embedded VMM is removed. `status` becomes `verified` when `verification` names a passing parity test (P5-05), and `deleted` when the legacy method is gone (P5-06).",
  "homes": {
    "api": "A501 operation (`target` is its operationId)",
    "node": "stays in the node, using the A501 operation in `target` when set",
    "backend": "inside the native backend, invisible to the node",
    "guest_gateway": "the authenticated guest API (P5-04)",
    "removed": "no replacement; `note` says why"
  },
  "capability_rules": {
    "invocation": {
      "override": [
        "run_vm"
      ]
    },
    "long_running": {
      "override": [
        "status_vm"
      ],
      "config": "restorable"
    },
    "pause": {
      "override": [
        "pause"
      ]
    },
    "snapshot": {
      "override": [
        "restore"
      ]
    },
    "exec": {
      "override": [
        "exec_vm"
      ],
      "exclude": {
        "wasm": "exec_vm only validated the module path and echoed it",
        "javascript": "exec_vm only transpiled the module and echoed it",
        "elpian": "exec_vm was start: an invocation, served by invokeWorkload",
        "elpify": "exec_vm was run_vm: an invocation, served by invokeWorkload"
      }
    },
    "terminal": {
      "never": true
    },
    "http_ingress": {
      "override": [
        "forward_http"
      ]
    },
    "files": {
      "override": [
        "copy_to_vm"
      ]
    },
    "build": {
      "override": [
        "build_image"
      ]
    },
    "chain_transactions": {
      "config": "supportsChainTrxs"
    },
    "execution_proofs": {
      "override": [
        "verify_program_execution"
      ]
    }
  },
