{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aseman.example/contracts/module/amod.schema.json",
  "title": "Aseman .amod bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "manifest_toml", "files", "signature"],
  "properties": {
    "format_version": {"const": 1},
    "manifest_toml": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_base64"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
          "content_base64": {"type": "string", "contentEncoding": "base64", "maxLength": 357913944}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature_hex"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "signature_hex": {"type": "string", "pattern": "^[0-9a-fA-F]{128}$"}
      }
    }
  }
}
