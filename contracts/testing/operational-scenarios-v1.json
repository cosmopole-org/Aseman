{
  "version": 1,
  "artifact": "A1002",
  "owner": "quality/operations",
  "report_schema": {
    "required": ["scenario", "started_at", "duration_seconds", "environment", "measurements", "thresholds", "passed"],
    "retention": "attach the immutable JSON report to the candidate release"
  },
  "scenarios": [
    {
      "id": "contract-parser-properties",
      "kind": "fuzz",
      "targets": ["parsers", "envelopes", "migration_inputs"],
      "command": "cargo test -p aseman-contracts parser_properties",
      "evidence": ["crates/aseman-contracts/src/parser_properties.rs"],
      "thresholds": {"cases_per_property": 512, "panics": 0}
    },
    {
      "id": "public-action-load-lite",
      "kind": "load",
      "targets": ["public_http", "idempotency"],
      "command": "cargo test -p aseman-application many_mutations_run_once_each_and_replay_their_first_outcome",
      "evidence": ["crates/aseman-application/src/public_action/tests.rs"],
      "thresholds": {"interleaved_mutations": 50, "duplicate_effects": 0}
    },
    {
      "id": "public-http-deployment-load",
      "kind": "load",
      "targets": ["public_http"],
      "command": "python3 scripts/run_http_load.py --url $ASEMAN_LOAD_URL --session-env ASEMAN_LOAD_SESSION --requests 10000 --concurrency 64 --p95-ms 1000 --max-error-rate 0.001",
      "required_env": ["ASEMAN_LOAD_URL", "ASEMAN_LOAD_SESSION"],
      "evidence": ["scripts/run_http_load.py"],
      "thresholds": {"requests": 10000, "concurrency": 64, "p95_millis": 1000, "maximum_error_rate": 0.001}
    },
    {
      "id": "realtime-postgres-capacity",
      "kind": "load",
      "targets": ["realtime"],
      "command": "cargo test -p aseman-realtime-durable --test load_realtime -- --nocapture",
      "required_env": ["ASEMAN_TEST_POSTGRES_URL", "ASEMAN_RUN_LOAD_TESTS"],
      "evidence": ["modules/realtime/durable/tests/load_realtime.rs", "contracts/realtime/capacity-v1.json"],
      "thresholds": {"events": 2000, "minimum_publish_events_per_second": 100, "dead_letters": 0, "sequence_errors": 0}
    },
    {
      "id": "guest-database-isolation-load",
      "kind": "load",
      "targets": ["guest_data"],
      "command": "cargo test -p aseman-storage-postgres --test live_guest_isolation -- --nocapture",
      "required_env": ["ASEMAN_TEST_POSTGRES_URL"],
      "evidence": ["modules/storage/postgres/tests/live_guest_isolation.rs"],
      "thresholds": {"cross_tenant_acceptances": 0, "role_leaks": 0}
    },
    {
      "id": "federation-partition-recovery",
      "kind": "chaos",
      "targets": ["federation"],
      "command": "cargo test -p aseman-federation-http --test live_two_clusters -- --nocapture",
      "required_env": ["ASEMAN_TEST_POSTGRES_URL"],
      "evidence": ["modules/federation/http/tests/live_two_clusters.rs"],
      "thresholds": {"duplicate_executions": 0, "routing_loops": 0, "unauthorized_acceptances": 0}
    },
    {
      "id": "worker-loss-and-drain",
      "kind": "failover",
      "targets": ["scheduling"],
      "command": "cargo test -p aseman-vmm-backend-nomad --test live_workers -- --nocapture",
      "required_env": ["ASEMAN_TEST_NOMAD_ENDPOINT"],
      "evidence": ["modules/vmm-backend/nomad/tests/live_workers.rs"],
      "thresholds": {"identity_changes": 0, "duplicate_workloads": 0, "unrecovered_workloads": 0}
    },
    {
      "id": "metering-settlement-soak",
      "kind": "soak",
      "targets": ["metering"],
      "command": "cargo test -p aseman-finance-ledger --test live_metering -- --nocapture",
      "required_env": ["ASEMAN_TEST_POSTGRES_URL", "ASEMAN_RUN_SOAK_TESTS"],
      "evidence": ["modules/finance/ledger/tests/live_metering.rs"],
      "thresholds": {"minimum_intervals": 1000, "duplicate_settlements": 0, "unbalanced_journals": 0, "maximum_settlement_lag_seconds": 300}
    },
    {
      "id": "release-rollback-drill",
      "kind": "rollback",
      "targets": ["release", "storage"],
      "command": "python3 scripts/check_rollout_policy.py --check",
      "evidence": ["contracts/deploy/rollout-policy.json", "docs/operations/staged-rollout.md"],
      "thresholds": {"semantic_mismatches": 0, "duplicate_effects": 0, "missing_audit_records": 0}
    }
  ]
}
