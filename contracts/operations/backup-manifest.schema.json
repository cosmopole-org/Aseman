{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aseman.dev/contracts/operations/backup-manifest.schema.json",
  "title": "Aseman signed backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "backup_id",
    "created_at",
    "source_cluster_id",
    "capsule_schema_versions",
    "provider_mappings",
    "module_versions",
    "artifacts",
    "signature"
  ],
  "properties": {
    "version": { "const": 1 },
    "backup_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_cluster_id": { "type": "string", "minLength": 1 },
    "capsule_schema_versions": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "provider_mappings": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "module_versions": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_name", "media_type", "size_bytes", "sha256"],
        "properties": {
          "logical_name": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "enum": ["ed25519"] },
        "key_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
